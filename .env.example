# Lokalna konfiguracja. Skopiuj do .env; nie commituj sekretów.
# Obecna integracja z lokalną Ollamą nie wymaga klucza API.
OLLAMA_HOST=http://model:11434
NOTE2TASK_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
DEFAULT_TIMEZONE=Europe/Warsaw
DEFAULT_DURATION_MINUTES=60
NOTE2TASK_API_PORT=8000
# Opcjonalnie ustaw inny adres klienta; domyślnie localhost:NOTE2TASK_API_PORT.
# NOTE2TASK_API_URL=http://localhost:8000

# Google Calendar demo account. Authorize on the host; never commit these files.
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_FILE=secrets/google_client.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
GOOGLE_CALENDAR_TIMEOUT=15
